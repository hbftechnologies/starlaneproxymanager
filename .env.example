# StarlaneProxyManager Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file — it contains secrets.

# ─── Database ────────────────────────────────────────────
# Supported: sqlite, mysql, postgres
DB_ENGINE=sqlite

# MySQL / PostgreSQL settings (ignored when DB_ENGINE=sqlite)
DB_HOST=db
DB_PORT=3306
DB_NAME=npm
DB_USER=npm
DB_PASSWORD=changeme

# SQLite path (relative to /data inside the container)
# DB_SQLITE_FILE=/data/database.sqlite

# ─── Initial Admin ───────────────────────────────────────
# Only used on first run to create the default admin account.
# INITIAL_ADMIN_EMAIL=admin@example.com
# INITIAL_ADMIN_PASSWORD=changeme

# ─── Runtime ─────────────────────────────────────────────
# Run the container process as this UID/GID (default: 0/0)
# PUID=1000
# PGID=1000

# Trust upstream proxy headers (e.g., Cloudflare, Traefik)
# X_FRAME_OPTIONS=sameorigin

# ─── Let's Encrypt ───────────────────────────────────────
# Disable Let's Encrypt certificate requests (default: false)
# DISABLE_IPV6=false

# ─── OIDC / SSO ──────────────────────────────────────────
# Set these to auto-configure OIDC on first run. Once seeded,
# the admin UI settings take over. Delete the database to re-seed.
# OIDC_ISSUER_URL=https://auth.example.com
# OIDC_CLIENT_ID=spm-client
# OIDC_CLIENT_SECRET=your-secret-here
# OIDC_SCOPES=openid email profile
# OIDC_AUTO_CREATE_USER=false
# OIDC_BUTTON_LABEL=Sign in with SSO

# Override OIDC-only mode. Set to "true" to force-show the
# password form even when OIDC-only mode is on. Emergency bypass.
# PASSWORD_FORM_SHOW=false

# ─── Logging ─────────────────────────────────────────────
# NODE_ENV=production
