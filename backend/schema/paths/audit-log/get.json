{
	"operationId": "getAuditLogs",
	"summary": "Get Audit Logs",
	"description": "Retrieve paginated and filtered audit logs.",
	"tags": ["audit-log"],
	"security": [
		{
			"bearerAuth": ["admin"]
		}
	],
	"parameters": [
		{
			"name": "page",
			"in": "query",
			"description": "Page number",
			"schema": {
				"type": "integer",
				"minimum": 1,
				"default": 1
			}
		},
		{
			"name": "limit",
			"in": "query",
			"description": "Items per page",
			"schema": {
				"type": "integer",
				"minimum": 1,
				"maximum": 500,
				"default": 50
			}
		},
		{
			"name": "date_from",
			"in": "query",
			"description": "Filter from date (ISO 8601)",
			"schema": {
				"type": "string"
			}
		},
		{
			"name": "date_to",
			"in": "query",
			"description": "Filter to date (ISO 8601)",
			"schema": {
				"type": "string"
			}
		},
		{
			"name": "user_id",
			"in": "query",
			"description": "Filter by user ID",
			"schema": {
				"type": "integer",
				"minimum": 1
			}
		},
		{
			"name": "action",
			"in": "query",
			"description": "Filter by action",
			"schema": {
				"type": "string",
				"enum": ["created", "updated", "deleted", "enabled", "disabled"]
			}
		},
		{
			"name": "object_type",
			"in": "query",
			"description": "Filter by object type",
			"schema": {
				"type": "string",
				"enum": ["proxy-host", "user", "certificate", "access-list", "stream", "dead-host", "redirection-host"]
			}
		},
		{
			"name": "query",
			"in": "query",
			"description": "Search text in meta",
			"schema": {
				"type": "string"
			}
		},
		{
			"name": "expand",
			"in": "query",
			"description": "Expand related objects (comma-separated)",
			"schema": {
				"type": "string"
			}
		}
	],
	"responses": {
		"200": {
			"description": "Paginated audit log list",
			"content": {
				"application/json": {
					"schema": {
						"$ref": "../../components/audit-log-paginated.json"
					},
					"examples": {
						"default": {
							"value": {
								"data": [
									{
										"id": 7,
										"created_on": "2024-10-08T13:09:54.000Z",
										"modified_on": "2024-10-08T13:09:54.000Z",
										"user_id": 1,
										"object_type": "user",
										"object_id": 3,
										"action": "updated",
										"meta": {}
									}
								],
								"pagination": {
									"total": 1,
									"page": 1,
									"limit": 50,
									"totalPages": 1
								}
							}
						}
					}
				}
			}
		}
	}
}
